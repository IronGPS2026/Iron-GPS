# =========================================================================
#  IRON GPS — Variables de entorno
#  Copia este archivo a ".env.local" y reemplaza los valores.
#  Las variables NEXT_PUBLIC_* son visibles en el navegador (frontend).
#  Las variables sin NEXT_PUBLIC_ solo viven en el servidor (más seguras).
# =========================================================================

# --- Sitio ---------------------------------------------------------------
# URL pública del sitio (sin slash final). Se usa para SEO, sitemap y Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.iron-gps.com

# --- WhatsApp ------------------------------------------------------------
# Número en formato internacional SIN "+" ni espacios. Ej: Colombia 57 + número.
# Reemplaza por tu número real:
NEXT_PUBLIC_WHATSAPP_NUMBER=573000000000

# --- Contacto ------------------------------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL=comercial@iron-gps.com
NEXT_PUBLIC_CONTACT_PHONE=

# --- Portal de clientes --------------------------------------------------
# URL de la plataforma donde tus clientes inician sesión (RedGPS marca blanca u otra).
NEXT_PUBLIC_CLIENT_PORTAL_URL=https://plataforma.iron-gps.com

# --- Analytics (opcional, dejar vacío para desactivar) -------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Formulario de leads (backend) --------------------------------------
# Opción A: Webhook (HubSpot, Zapier, Make, tu CRM, etc.). Recomendado.
CRM_WEBHOOK_URL=

# Opción B: Envío por email vía Resend (https://resend.com). Opcional.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=comercial@iron-gps.com
